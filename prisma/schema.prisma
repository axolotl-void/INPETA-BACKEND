// === PENGATURAN MESIN ===
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// === TABEL 1: USERS (Akses Admin) ===
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  nama_lengkap String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())

  @@map("users") 
}

// === TABEL 2: PENGATURAN WEB (Landing Page) ===
model PengaturanWeb {
  id             Int      @id @default(1)
  nama_instansi  String
  alamat_lengkap String
  email_kontak   String
  no_telepon     String
  stat_populasi  String
  stat_wilayah   String
  stat_fasilitas String

  @@map("pengaturan_web")
}

// === TABEL 3: WILAYAH (Peta Poligon) ===
model Wilayah {
  id              Int     @id @default(autoincrement())
  nama_wilayah    String
  level           String  // Isi nanti: KABUPATEN atau KECAMATAN
  parent_id       Int?
  geojson_polygon Json?
  warna_area      String?
  
  populasi        Populasi[]
  fasilitas       Fasilitas[]

  @@map("wilayah")
}

// === TABEL 4: POPULASI (Statistik) ===
model Populasi {
  id          String  @id @default(uuid())
  wilayah_id  Int
  tahun       Int
  jml_sapi    Int     @default(0)
  jml_kambing Int     @default(0)
  jml_ayam    Int     @default(0)
  jml_kerbau  Int     @default(0)

  // Sambungan ke tabel Wilayah
  wilayah     Wilayah @relation(fields: [wilayah_id], references: [id])

  // Cegah duplikat: 1 wilayah gak boleh punya 2 data populasi di tahun yg sama
  @@unique([wilayah_id, tahun]) 
  @@map("populasi")
}

// === TABEL 5: FASILITAS (Titik Marker) ===
model Fasilitas {
  id          String  @id @default(uuid())
  wilayah_id  Int
  nama_lokasi String
  kategori    String  // Isi nanti: PUSKESWAN, RPH, PASAR, dll
  latitude    Float   // Desimal untuk Y
  longitude   Float   // Desimal untuk X
  alamat      String?

  // Sambungan ke tabel Wilayah
  wilayah     Wilayah @relation(fields: [wilayah_id], references: [id])

  @@map("fasilitas")
}

// ==========================================
// ⬇️ TABEL BARU UNTUK CMS TAMPILAN DEPAN ⬇️
// ==========================================

// === TABEL 6: LOGO ===
model Logo {
  id          Int      @id @default(autoincrement())
  image_url   String   @db.VarChar(255)
  name        String   @db.VarChar(100)
  is_active   Boolean  @default(false)
  uploaded_at DateTime @default(now())

  @@map("logo")
}

// === TABEL 7: NAVBAR MENUS ===
model NavbarMenu {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(100)
  url         String       @db.VarChar(255)
  parent_id   Int?         // Nullable untuk menu utama
  order_index Int          @default(0)

  // Relasi ke diri sendiri (Self-relation) untuk sub-menu
  parent      NavbarMenu?  @relation("MenuToSubmenu", fields: [parent_id], references: [id])
  children    NavbarMenu[] @relation("MenuToSubmenu")

  @@map("navbar_menus")
}

// === TABEL 8: HERO CONTENTS ===
model HeroContent {
  id          Int      @id @default(autoincrement())
  main_title  String   @db.VarChar(255)
  description String   @db.Text
  is_active   Boolean  @default(false)
  updated_at  DateTime @updatedAt // Otomatis update waktu tiap kali diubah

  @@map("hero_contents")
}

// === TABEL 9: HERO STATS ===
model HeroStat {
  id          Int      @id @default(autoincrement())
  stat_value  String   @db.VarChar(50)
  stat_label  String   @db.VarChar(100)
  order_index Int      @default(0)

  @@map("hero_stats")
}

// === TABEL 10: TENTANG CONTENT ===
model TentangContent {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  image_url   String?
  is_active   Boolean  @default(false)

  @@map("tentang_contents")
}

// === TABEL 11: TENTANG POINTS ===
model TentangPoint {
  id    Int     @id @default(autoincrement())
  text  String
  url   String?

  @@map("tentang_points")
}

// === TABEL 12: FITUR UNGGULAN ===
model FiturUnggulan {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  icon_url    String
  url         String?

  @@map("fitur_unggulan")
}